# Flow declarations for the CallMeMaybe reflection bridge.
# Link against the cmm_flow_bridge library and register reflected C++ entities
# before the first lookup/invocation.

const CMM_FLOW_VOID: u32 = 0
const CMM_FLOW_BOOL: u32 = 1
const CMM_FLOW_I8: u32 = 2
const CMM_FLOW_U8: u32 = 3
const CMM_FLOW_I16: u32 = 4
const CMM_FLOW_U16: u32 = 5
const CMM_FLOW_I32: u32 = 6
const CMM_FLOW_U32: u32 = 7
const CMM_FLOW_I64: u32 = 8
const CMM_FLOW_U64: u32 = 9
const CMM_FLOW_F32: u32 = 10
const CMM_FLOW_F64: u32 = 11
const CMM_FLOW_POINTER: u32 = 12
const CMM_FLOW_STRING: u32 = 13
const CMM_FLOW_BYTES: u32 = 14
const CMM_FLOW_UNSUPPORTED: u32 = 255

struct CmmFlowValue {
    kind: u32,
    reserved: u32,
    bits: u64,
    extra: u64
}

extern {
    function cmm_flow_reflect_name(name: string) -> u64
    function cmm_flow_parameter_count(function_id: u64) -> u64
    function cmm_flow_parameter_kind(function_id: u64, index: u64) -> u32
    function cmm_flow_return_kind(function_id: u64) -> u32
    function cmm_flow_invoke(function_id: u64, arguments: ptr<CmmFlowValue>, argument_count: u64, result: ptr<CmmFlowValue>) -> i32
    function cmm_flow_error_string(error: i32) -> string
    function cmm_flow_f32_bits(value: f32) -> u64
    function cmm_flow_f64_bits(value: f64) -> u64
    function cmm_flow_bits_f32(bits: u64) -> f32
    function cmm_flow_bits_f64(bits: u64) -> f64
    function cmm_flow_string_bits(value: string) -> u64
    function cmm_flow_bits_string(bits: u64) -> string
    function cmm_flow_byte_span_data(value: span<u8>) -> u64
    function cmm_flow_bits_u8_ptr(bits: u64) -> ptr<u8>
}

export function cmm_i8(value: i8) -> CmmFlowValue { return CmmFlowValue { kind: CMM_FLOW_I8, reserved: 0, bits: value as u64, extra: 0 } }
export function cmm_u8(value: u8) -> CmmFlowValue { return CmmFlowValue { kind: CMM_FLOW_U8, reserved: 0, bits: value as u64, extra: 0 } }
export function cmm_i16(value: i16) -> CmmFlowValue { return CmmFlowValue { kind: CMM_FLOW_I16, reserved: 0, bits: value as u64, extra: 0 } }
export function cmm_u16(value: u16) -> CmmFlowValue { return CmmFlowValue { kind: CMM_FLOW_U16, reserved: 0, bits: value as u64, extra: 0 } }
export function cmm_i32(value: i32) -> CmmFlowValue { return CmmFlowValue { kind: CMM_FLOW_I32, reserved: 0, bits: value as u64, extra: 0 } }
export function cmm_u32(value: u32) -> CmmFlowValue { return CmmFlowValue { kind: CMM_FLOW_U32, reserved: 0, bits: value as u64, extra: 0 } }
export function cmm_i64(value: i64) -> CmmFlowValue { return CmmFlowValue { kind: CMM_FLOW_I64, reserved: 0, bits: value as u64, extra: 0 } }
export function cmm_u64(value: u64) -> CmmFlowValue { return CmmFlowValue { kind: CMM_FLOW_U64, reserved: 0, bits: value, extra: 0 } }
export function cmm_f32(value: f32) -> CmmFlowValue { return CmmFlowValue { kind: CMM_FLOW_F32, reserved: 0, bits: cmm_flow_f32_bits(value), extra: 0 } }
export function cmm_f64(value: f64) -> CmmFlowValue { return CmmFlowValue { kind: CMM_FLOW_F64, reserved: 0, bits: cmm_flow_f64_bits(value), extra: 0 } }

export function cmm_bool(value: bool) -> CmmFlowValue {
    if value { return CmmFlowValue { kind: CMM_FLOW_BOOL, reserved: 0, bits: 1, extra: 0 } }
    return CmmFlowValue { kind: CMM_FLOW_BOOL, reserved: 0, bits: 0, extra: 0 }
}

export function cmm_string(value: string) -> CmmFlowValue {
    return CmmFlowValue { kind: CMM_FLOW_STRING, reserved: 0, bits: cmm_flow_string_bits(value), extra: 0 }
}

export function cmm_bytes(value: span<u8>) -> CmmFlowValue {
    return CmmFlowValue {
        kind: CMM_FLOW_BYTES,
        reserved: 0,
        bits: cmm_flow_byte_span_data(value),
        extra: value.len as u64
    }
}

export function cmm_as_i8(value: CmmFlowValue) -> i8 { return value.bits as i8 }
export function cmm_as_u8(value: CmmFlowValue) -> u8 { return value.bits as u8 }
export function cmm_as_i16(value: CmmFlowValue) -> i16 { return value.bits as i16 }
export function cmm_as_u16(value: CmmFlowValue) -> u16 { return value.bits as u16 }
export function cmm_as_i32(value: CmmFlowValue) -> i32 { return value.bits as i32 }
export function cmm_as_u32(value: CmmFlowValue) -> u32 { return value.bits as u32 }
export function cmm_as_i64(value: CmmFlowValue) -> i64 { return value.bits as i64 }
export function cmm_as_u64(value: CmmFlowValue) -> u64 { return value.bits }
export function cmm_as_f32(value: CmmFlowValue) -> f32 { return cmm_flow_bits_f32(value.bits) }
export function cmm_as_f64(value: CmmFlowValue) -> f64 { return cmm_flow_bits_f64(value.bits) }
export function cmm_as_bool(value: CmmFlowValue) -> bool { return value.bits != 0 }
export function cmm_as_string(value: CmmFlowValue) -> string { return cmm_flow_bits_string(value.bits) }

export function cmm_as_byte_span(value: CmmFlowValue) -> span<u8> {
    let data: ptr<u8> = cmm_flow_bits_u8_ptr(value.bits)
    return data[0..value.extra as i64]
}
